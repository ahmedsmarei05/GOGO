<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GOGO | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/">GOGO</a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/collection">Collection</a>
          <span id="authArea"></span>
        </nav>
      </div>
    </header>

    <main class="container">
      <h1 class="page-title">Admin dashboard</h1>
      <p class="muted">View users, manage catalog, and track COD orders.</p>

      <div class="grid admin-grid">
        <section class="card admin-panel">
          <h2>Overview</h2>
          <p>Customer accounts: <strong id="totalUsers">0</strong></p>
          <p>Orders: <strong id="totalOrders">0</strong></p>
          <p>Products listed: <strong id="totalProducts">0</strong></p>
        </section>

        <section class="card admin-panel">
          <h2>Add product</h2>
          <form id="addProductForm" novalidate enctype="multipart/form-data">
            <div class="form-group">
              <label for="pName">Name</label>
              <input id="pName" name="name" type="text" required />
              <p id="nameError" class="error field-error"></p>
            </div>
            <div class="form-group">
              <label for="pCategory">Category</label>
              <input id="pCategory" name="category" type="text" required />
              <p id="categoryError" class="error field-error"></p>
            </div>
            <div class="form-group">
              <label for="pPrice">Price</label>
              <input id="pPrice" name="price" type="number" min="0" step="0.01" required />
              <p id="priceError" class="error field-error"></p>
            </div>
            <div class="form-group">
              <label for="pImage">Product image</label>
              <input id="pImage" name="pImage" type="file" accept="image/*" required />
              <p id="pImageError" class="error field-error"></p>
            </div>
            <div class="form-group">
              <label for="pDescription">Description</label>
              <textarea id="pDescription" name="description" rows="2" required></textarea>
              <p id="descriptionError" class="error field-error"></p>
            </div>
            <button class="btn btn-primary" type="submit">Add to catalog</button>
            <p id="addProductSuccess" class="success"></p>
          </form>
        </section>
      </div>

      <section class="card admin-panel">
        <h2>Users</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="usersTableBody"></tbody>
          </table>
        </div>
      </section>

      <div class="grid admin-grid">
        <section class="card admin-panel">
          <h2>Products</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="productsTableBody"></tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="card admin-panel">
        <h2>Orders</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Order ID</th>
                <th>User</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Items</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ordersTableBody"></tbody>
          </table>
        </div>
      </section>
    </main>

    <div id="editUserModal" class="modal-overlay" hidden>
      <div class="card modal-card">
        <h2>Edit user</h2>
        <form id="editUserForm" novalidate>
          <input type="hidden" id="editUserId" />
          <div class="form-group">
            <label for="editUserName">Name</label>
            <input id="editUserName" name="name" type="text" required />
            <p id="editNameError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editUserEmail">Email</label>
            <input id="editUserEmail" name="email" type="email" required />
            <p id="editEmailError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editUserRole">Role</label>
            <select id="editUserRole" name="role">
              <option value="user">User</option>
              <option value="admin">Admin</option>
            </select>
            <p id="editRoleError" class="error field-error"></p>
          </div>
          <div class="modal-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <button class="btn btn-secondary" type="button" id="cancelEditUser">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <div id="editProductModal" class="modal-overlay" hidden>
      <div class="card modal-card modal-card-wide">
        <h2>Edit product</h2>
        <form id="editProductForm" novalidate enctype="multipart/form-data">
          <input type="hidden" id="editProductId" />
          <div class="form-group">
            <label for="editProductName">Name</label>
            <input id="editProductName" name="name" type="text" required />
            <p id="editProductNameError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editProductCategory">Category</label>
            <input id="editProductCategory" name="category" type="text" required />
            <p id="editProductCategoryError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editProductPrice">Price (USD)</label>
            <input id="editProductPrice" name="price" type="number" min="0" step="0.01" required />
            <p id="editProductPriceError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editProductImage">Replace image (optional)</label>
            <input id="editProductImage" name="pImage" type="file" accept="image/*" />
            <p id="editProductImageError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editProductDescription">Description</label>
            <textarea id="editProductDescription" name="description" rows="2" required></textarea>
            <p id="editProductDescriptionError" class="error field-error"></p>
          </div>
          <div class="modal-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <button class="btn btn-secondary" type="button" id="cancelEditProduct">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <div id="editOrderModal" class="modal-overlay" hidden>
      <div class="card modal-card modal-card-wide">
        <h2>Edit order</h2>
        <form id="editOrderForm" novalidate>
          <input type="hidden" id="editOrderId" />
          <p class="muted" id="editOrderSummary"></p>
          <div class="form-group">
            <label for="editOrderStatus">Status</label>
            <select id="editOrderStatus" name="status">
              <option value="Pending (COD)">Pending (COD)</option>
              <option value="Processing">Processing</option>
              <option value="Shipped">Shipped</option>
              <option value="Delivered">Delivered</option>
              <option value="Cancelled">Cancelled</option>
            </select>
            <p id="editOrderStatusError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editOrderPhone">Phone</label>
            <input id="editOrderPhone" name="phone" type="tel" required />
            <p id="editOrderPhoneError" class="error field-error"></p>
          </div>
          <div class="form-group">
            <label for="editOrderAddress">Delivery address</label>
            <textarea id="editOrderAddress" name="address" rows="3" required></textarea>
            <p id="editOrderAddressError" class="error field-error"></p>
          </div>
          <div class="modal-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <button class="btn btn-secondary" type="button" id="cancelEditOrder">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <script src="/js/common.js"></script>
    <script src="/js/admin.js"></script>
  </body>
</html>
